<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /plexusbiz/

    # Canonical entry point: /plexusbiz -> /plexusbiz/public/
    RewriteRule ^$ /plexusbiz/public/ [R=302,L]

    # Canonicalize duplicated subfolder URLs at the root rewrite layer.
    RewriteCond %{REQUEST_URI} ^/plexusbiz/public/plexusbiz/public/(.+)$ [NC]
    RewriteRule ^ /plexusbiz/public/%1 [R=302,L]
    RewriteCond %{REQUEST_URI} ^/plexusbiz/public/plexusbiz/public/?$ [NC]
    RewriteRule ^ /plexusbiz/public/ [R=302,L]

    # Block direct access to hidden files when project root is web-accessible.
    RewriteRule (^|/)\. - [F,L]

    # Keep ACME challenge files reachable when present.
    RewriteRule ^\.well-known/ - [L]

    # Prevent browsing non-public project directories from web.
    RewriteCond %{REQUEST_URI} !^/plexusbiz/public(?:/|$) [NC]
    RewriteCond %{REQUEST_URI} !^/plexusbiz/?$ [NC]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [F,L]

    # Send traffic to /public (same pattern used by the working sibling projects).
    RewriteCond %{REQUEST_URI} !^/plexusbiz/public(?:/|$) [NC]
    RewriteRule ^(.*)$ /plexusbiz/public/$1 [L]
</IfModule>
