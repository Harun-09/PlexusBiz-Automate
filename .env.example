APP_NAME="PlexusBiz Automate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SUBFOLDER_PATH=
ASSET_URL=
VITE_BUILD_BASE=/build/
# Subfolder deploy example:
# APP_URL=http://harun.intelsofts.com/plexusbiz
# APP_SUBFOLDER_PATH=/plexusbiz
# ASSET_URL=
# VITE_BUILD_BASE=/plexusbiz/build/

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plexus_biz_automate
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MODULE_ADMIN_ENABLED=true
MODULE_CRM_ENABLED=true
MODULE_ECOMMERCE_ENABLED=true
MODULE_MARKETING_ENABLED=true
MODULE_NOTIFICATIONS_ENABLED=true
MODULE_SETTINGS_ENABLED=true
MODULE_SOCIAL_ENABLED=true
MODULE_SUPPORT_ENABLED=true
MODULE_WORKFLOW_ENABLED=true

COMMERCE_CURRENCY=BDT
COMMERCE_DEFAULT_PAYMENT_GATEWAY=stripe

STRIPE_MODE=sandbox
STRIPE_SANDBOX_PUBLIC_KEY=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_LIVE_PUBLIC_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
STRIPE_BRAND_DISPLAY_NAME=PlexusBiz
STRIPE_BRAND_BUTTON_COLOR=#1d4ed8
STRIPE_BRAND_BACKGROUND_COLOR=#f8fafc
STRIPE_BRAND_BORDER_STYLE=rounded
STRIPE_BRAND_FONT_FAMILY=inter
STRIPE_BRAND_LOGO_URL=
STRIPE_BRAND_ICON_URL=

SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MULTI_CARD_NAME=
MARKETING_EMAIL_PROVIDER=mock
MARKETING_SMS_PROVIDER=mock
SOCIAL_FACEBOOK_PROVIDER=mock
SOCIAL_INSTAGRAM_PROVIDER=mock
SOCIAL_FACEBOOK_GRAPH_VERSION=v24.0
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
WORKFLOW_WEBHOOK_SIGNING_SECRET=
CHATBOT_DEFAULT_LOCALE=en
API_RATE_LIMIT_PER_MINUTE=60

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
